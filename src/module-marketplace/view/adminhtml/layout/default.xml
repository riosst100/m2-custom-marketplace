<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="TCGCollective_MarketPlace::css/select2/select2.min.css" />
    </head>
	<body>
		<referenceBlock name="require.js" template="TCGCollective_MarketPlace::page/js/require_js.phtml" />
		<referenceContainer name="notifications">
			<referenceBlock name="notifications_message" template="TCGCollective_MarketPlace::notifications/message.phtml"/>
		</referenceContainer>
        <referenceContainer name="header">
            <block class="Magento\Backend\Block\Page\Header" name="logo" before="-">
                <arguments>
                    <argument name="show_part" xsi:type="string">logo</argument>
                    <argument name="edition" translate="true" xsi:type="string">Community Edition</argument>
                    <argument name="logo_image_src" xsi:type="string">TCGCollective_MarketPlace::images/logo.png</argument>
                </arguments>
            </block>
        </referenceContainer>
	</body>
</page>
