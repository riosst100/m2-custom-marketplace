        <script>
          document.addEventListener("DOMContentLoaded", function() {
            const btn = document.getElementById("show-hash-btn");
            if (!btn) return; // Guard: button not present

            // Prevent double-initialization if template re-renders
            if (btn.dataset.inited === "1") return;
            btn.dataset.inited = "1";

            // Prefer server-generated absolute URL via data attribute
            const serverTargetUrl = btn.dataset.targetUrl || "";

            function normalizeUrlPath(url) {
              try {
                if (!url) return url;
                // Fix duplicated 'marketplace/marketplace' segments
                url = url.replace(/\/marketplace\/marketplace\//g, '/marketplace/');
                // Collapse multiple slashes (but keep protocol part intact)
                const parts = url.split('://');
                if (parts.length > 1) {
                  return parts[0] + '://' + parts.slice(1).join('://').replace(/\/\/+/, '/').replace(/([^:])\/\/+/, '$1/');
                }
                return url.replace(/\/\/+/, '/');
              } catch (e) {
                return url;
              }
            }

            // Fallback: derive base prefix from current path (store code aware)
            function getBasePrefix() {
              const pathParts = window.location.pathname.split('/').filter(Boolean);
              const idx = pathParts.indexOf('marketplace');
              if (idx > 0) {
                return '/' + pathParts.slice(0, idx).join('/') + '/';
              }
              // If no 'marketplace' segment, keep root or first segment as prefix
              return pathParts.length ? '/' + pathParts[0] + '/' : '/';
            }

            const fallbackTargetUrl = window.location.origin + getBasePrefix() + 'marketplace/lofmpsellermembership/membership/index/#step_membership';
            const targetUrl = normalizeUrlPath(serverTargetUrl || fallbackTargetUrl);

            function showButton() {
              btn.style.display = "inline-block";
              btn.textContent = "Continue to Select Plan";
              btn.setAttribute('aria-hidden', 'false');
            }

            function hideButton() {
              btn.style.display = "none";
              btn.setAttribute('aria-hidden', 'true');
            }

            // Detect payment methods page regardless of host/locale (e.g., /sg/marketplace/catalog/payment/methods/)
            function isPaymentMethodsPath() {
              try {
                const cleanPath = window.location.pathname.replace(/\/+$/, ''); // trim trailing slashes
                const parts = cleanPath.split('/').filter(Boolean).map(p => p.toLowerCase());
                const idx = parts.indexOf('marketplace');
                if (idx === -1) return false;
                const after = parts.slice(idx).join('/');
                return after === 'marketplace/catalog/payment/methods' || after.startsWith('marketplace/catalog/payment/methods/');
              } catch (_) {
                return false;
              }
            }

            function updateButtonVisibility() {
              const hashRaw = window.location.hash || "";
              const hash = hashRaw.toLowerCase();
              // Show button ONLY on #step_payment (tolerate trailing params)
              if (hash.startsWith("#step_payment") || isPaymentMethodsPath()) {
                showButton();
              } else {
                hideButton();
              }
            }

            // Button click → redirect to membership step
            btn.addEventListener("click", function() {
              try {
                // Avoid navigating if already on the target URL
                if (window.location.href !== targetUrl) {
                  window.location.assign(targetUrl);
                }
              } catch (e) {
                // Fallback hard redirect
                window.location.href = targetUrl;
              }
            });

            // Initial check
            updateButtonVisibility();

            // Re-check when hash changes
            window.addEventListener("hashchange", updateButtonVisibility);
          });
          </script>
        
