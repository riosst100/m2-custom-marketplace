<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <columns name="email_template_columns">
        <actionsColumn name="actions" class="Magento\Email\Ui\Component\Listing\Column\TemplateActions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">template_id</item>
                    <item name="viewUrlPath" xsi:type="string">adminhtml/email_template/preview</item>
                    <item name="editUrlPath" xsi:type="string">adminhtml/email_template/edit</item>
                </item>
            </argument>
        </actionsColumn>

        <column name="email_receiver">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Email Receiver</item>
                    <item name="filter" xsi:type="string">select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="options" xsi:type="array">
                        <item name="admin" xsi:type="array">
                            <item name="label" xsi:type="string">Admin</item>
                            <item name="value" xsi:type="string">admin</item>
                        </item>
                        <item name="seller" xsi:type="array">
                            <item name="label" xsi:type="string">Seller</item>
                            <item name="value" xsi:type="string">seller</item>
                        </item>
                    </item>
                </item>
            </argument>
        </column>

    </columns>

</listing>
