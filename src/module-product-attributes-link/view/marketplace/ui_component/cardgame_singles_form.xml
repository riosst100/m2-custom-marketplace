<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">cardgame_singles_form.cardgame_singles_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Catalog Price Rule</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="TCGCollective\ProductAttributesLink\Block\Adminhtml\Generic\Back"/>
            <button name="save" class="TCGCollective\ProductAttributesLink\Block\Adminhtml\CardGameSingles\Save"/>
        </buttons>
        <namespace>cardgame_singles_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>cardgame_singles_form.cardgame_singles_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="cardgame_singles_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="TCGCollective\ProductAttributesLink\Ui\DataProvider\Form\CardGamesCardDataProvider" name="cardgame_singles_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <collapsible>false</collapsible>
            <opened>true</opened>
            <label translate="true"></label>
        </settings>
        <field name="entity_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="set_id" component="Magento_Catalog/js/components/new-category" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="showCheckbox" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Set Name</label>
                <dataScope>set_id</dataScope>
                <disabled>true</disabled>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
                <listens>
                    <link name="${ $.namespace }.${ $.namespace }:responseData">setParsed</link>
                </listens>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="TCGCollective\ProductAttributesLink\Model\Source\CardGame\CardSet"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="card_name" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Name</label>
                <visible>true</visible>
                <dataScope>card_name</dataScope>
            </settings>
        </field>
        <field name="card_number" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Number</label>
                <visible>true</visible>
                <dataScope>card_number</dataScope>
            </settings>
        </field>
        <field name="card_rarity" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Rarity</label>
                <visible>true</visible>
                <dataScope>card_rarity</dataScope>
            </settings>
        </field>
        <field name="card_type" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Type</label>
                <visible>true</visible>
                <dataScope>card_type</dataScope>
            </settings>
        </field>
        <field name="card_sub_type" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Sub Type</label>
                <visible>true</visible>
                <dataScope>card_sub_type</dataScope>
            </settings>
        </field>
        <field name="card_artist" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Artist</label>
                <visible>true</visible>
                <dataScope>card_artist</dataScope>
            </settings>
        </field>
        <field name="card_feature" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Feature</label>
                <visible>true</visible>
                <dataScope>card_feature</dataScope>
            </settings>
        </field>
        <field name="release_type" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Release Type</label>
                <visible>true</visible>
                <dataScope>release_type</dataScope>
            </settings>
        </field>
        <field name="release_year" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_sets</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Release Year</label>
                <visible>true</visible>
                <dataScope>release_year</dataScope>
            </settings>
        </field>
        <field name="release_date" formElement="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="validate-date" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Release Date</label>
                <visible>true</visible>
                <dataScope>release_date</dataScope>
            </settings>
        </field>
        <field name="color" component="Magento_Catalog/js/components/new-category" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="showCheckbox" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Card Color</label>
                <visible>true</visible>
                <dataScope>card_color</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
                <listens>
                    <link name="${ $.namespace }.${ $.namespace }:responseData">setParsed</link>
                </listens>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="TCGCollective\ProductAttributesLink\Model\Source\Generic\Color"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="language" component="Magento_Catalog/js/components/new-category" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">cardgame_singles</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="showCheckbox" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Language</label>
                <visible>true</visible>
                <dataScope>language</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
                <listens>
                    <link name="${ $.namespace }.${ $.namespace }:responseData">setParsed</link>
                </listens>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="TCGCollective\ProductAttributesLink\Model\Source\CardGamesMapping\CardLanguage"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
