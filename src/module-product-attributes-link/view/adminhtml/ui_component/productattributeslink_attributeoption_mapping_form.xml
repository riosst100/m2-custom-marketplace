                                </action>
                                <action name="2">
                                    <target>productattributeslink_attributeoption_mapping_form.productattributeslink_attributeoption_mapping_form.attributeoption_mapping.attribute_option_id</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Entity Type</label>
                <visible>false</visible>
                <dataScope>entity_type</dataScope>
            </settings>
        </field>
