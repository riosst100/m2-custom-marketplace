            <button name="back" class="TCGCollective\ProductAttributesLink\Block\Adminhtml\AttributeSet\Back"/>
        </buttons>
        <namespace>productattributeslink_brands_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>productattributeslink_brands_form.productattributeslink_brands_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="productattributeslink_brands_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="TCGCollective\ProductAttributesLink\Ui\DataProvider\Form\BrandsDataProvider" name="productattributeslink_brands_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
