<script>
    require([
        'jquery'
    ], function ($) {
        $('#default_country_selection').change(function() {
            $('input[name="default_country"]').val($(this).val());
        });

        $('#show_features').click(function() {
            $('#show_features').hide();
            $('#hide_features').show();
            $('#features_list').slideDown();
        });

        $('#hide_features').click(function() {
            $('#show_features').show();
            $('#hide_features').hide();
            $('#features_list').slideUp();
        });

        $('#show_platform_membership').click(function(){
            $('#buy_platform_membership').slideToggle();
        });

        $('#show_listing_membership').click(function(){
            $('#buy_listing_membership').slideToggle();
        });
    });

    require(['jquery', 'mage/translate'], function ($) {
        $(document).ready(function () {
            // Bind submit event to all membership forms
            $('form[data-role="tocart-form"]').on('submit', function (e) {
                var $defaultCountry = $('#default_country_selection');
                var countryVal = $defaultCountry.val();

                // Only validate if this select exists on the page (i.e., first-time buyers)
                if ($defaultCountry.length && (!countryVal || countryVal === '')) {
                    e.preventDefault();

                    // Remove any previous message
                    $('.default-country-error').remove();

                    // Insert error message below the select
                    $('<div class="message message-error default-country-error" style="margin-top:8px;color:#d32f2f;font-weight:500;">'
                        + $.mage.__('Please select a country before proceeding.')
                        + '</div>').insertAfter($defaultCountry);

                    // Scroll to the select for better UX
                    $('html, body').animate({
                        scrollTop: $defaultCountry.offset().top - 100
                    }, 300);
                    return false;
                }
            });
        });
    });

    require([
        'jquery',
        'mage/translate',
        'Magento_Ui/js/modal/confirm'
    ], function ($, $t, confirm) {

        $(document).ready(function () {
            $('form[data-role="tocart-form"]').on('submit', function (e) {
                var $form = $(this);
                var $button = $form.find('button[type="submit"]');
                var buttonText = $button.text().trim().toLowerCase();

                // Detect upgrade scenario
                if ($button.data('plan-action') === 'upgrade plan' || $button.data('plan-action') === 'renew plan') {
                    e.preventDefault(); // Stop form temporarily

                    confirm({
                        title: $t('Re-verification Required'),
                        content: $t('Upgrading your plan will require re-verification. Do you want to continue?'),
                        actions: {
                            confirm: function () {
                                // Continue submit
                                $form.off('submit').submit();
                            },
                            cancel: function () {
                                // Stay on page
                                return false;
                            }
                        }
                    });
                }
            });
        });
    });
</script>
