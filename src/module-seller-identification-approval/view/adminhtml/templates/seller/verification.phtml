<?php
use Lofmp\SellerIdentificationApproval\Block\Seller\Register;

/**
 * @var Register $block
 */

$listType = $block->getIdentificationTypes();
$ids = [];
?>
<div class="negotiable-quote-errors messages">
    <div class="message error-wrap error" data-role="error-wrap"></div>
</div>
<input type="hidden" name="delete_ids">
<div class="doc-container">
    <?php foreach ($listType as $key => $label) : ?>
        <?php if ($block->isEnable($key)) : ?>
            <?php 
            $files = $block->getFileUpload($key);
            $count = $files ? count($files) + 1 : 1;
            ?>
            <div class="doc-card">
                <h2><?= $block->escapeHtml($label); ?></h2>
                <ul>
                    <?php if (count($files)): ?>
                        <?php $index = 1; ?>
                        <?php foreach ($files as $file) :?>
                            <label tabindex="0" data-mage-init='{"Lofmp_SellerIdentificationApproval/js/upload/add-file": {}}'
                                    for="<?= $key ?>-add-file-<?= $index ?>" style="display:none">
                                <input name="<?= $key ?>-files[<?= $index ?>]" data-role="<?= $key ?>-add-file" id="<?= $key ?>-add-file" type="file">
                                <?= $block->escapeHtml(__('Attach file')) ?>
                            </label>
                            <li>
                                <a href="<?= $block->escapeUrl($block->getAttachmentUrl($file->getEntityId())) ?>"
                                title="<?= $block->escapeHtmlAttr($file->getFileName()) ?>"><?= $block->escapeHtml($file->getFileName()) ?>
                                </a>
                                <span class="status verified">Uploaded at <?= $file->getData('created_at') ?></span>
                            </li>
                            <?php $index++; ?>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <div>No documents uploaded.</div>
                    <?php endif; ?>
                </ul>
            </div>
        <?php endif; ?>
    <?php endforeach; ?>
</div>

<style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      background: #f4f6f9;
      color: #333;
    }

    .doc-container {
      max-width: 820px;
    margin: 0px auto;
      /* padding: 10px; */
    }

    .doc-card {
      border-radius: 14px;
      background: #fff;
      padding: 20px;
      margin-bottom: 20px;
      /* box-shadow: 0 3px 8px rgba(0,0,0,0.08); */
      border: 1px solid #d5d5d5;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .doc-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 3px 5px rgba(0,0,0,0.12);
    }

    .doc-card h2 {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 12px 0;
      color: #222;
      border-left: 4px solid #1a73e8;
      padding-left: 10px;
    }

    .doc-card ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .doc-card li {
      padding: 8px 0;
      border-bottom: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .doc-card li:last-child {
      border-bottom: none;
    }

    .doc-card a {
      color: #1a73e8;
      text-decoration: none;
      font-size: 15px;
    }

    .doc-card a:hover {
      text-decoration: underline;
    }

    .status {
      font-size: 13px;
      font-weight: 500;
      padding: 3px 8px;
      border-radius: 6px;
    }

    .status.verified {
      background: #d5d5d5;
      /* color: grey; */
    }

    .status.pending {
      background: #fff4e5;
      color: #b06000;
    }

    .status.rejected {
      background: #fce8e6;
      color: #c5221f;
    }
  </style>
<script>
    require([
        "jquery"
    ], function ($) {
        $(document).ready(function () {

            showReasonField();

            $('#seller_documents_verify_status').on('change', function(){
                var status = $(this).val();

                reasonFieldDepend(status);
                
                return true;
            });

            function showReasonField() 
            {
                var status = $('#seller_documents_verify_status').val();
                
                reasonFieldDepend(status);

                return true;
            }

            function reasonFieldDepend(status) 
            {
                if (status == 3) {
                    $('#disapproved_reason_container').show();
                } else {
                    $('#disapproved_reason_container').hide();
                }
            }

            var ids = [];
            $('.delete-old').on('click', function () {
                var deleteId = $(this).attr('id');
                ids.push(deleteId);
                $('[name="delete_ids"]').val(ids.toString());
                $(this).closest('[data-role="attached-item"]').remove();
            })
        })
    });
</script>