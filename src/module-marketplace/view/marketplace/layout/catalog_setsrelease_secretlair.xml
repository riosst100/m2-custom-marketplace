<?xml version="1.0"?>
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_layout.xsd">
    <container name="root">
        <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Edit\Tab\Sets\Config\CardgameMatrix" template="TCGCollective_MarketPlace::catalog/product/edit/super/secretlair-wizard-ajax.phtml" as="secretlair.wizard">
            <arguments>
                <argument name="config" xsi:type="array">
                    <item name="collapsible" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true" />
                    <item name="sortOrder" xsi:type="string">3333</item>
                    <item name="canShow" xsi:type="boolean">true</item>
                    <item name="componentType" xsi:type="string">fieldset</item>
                    <item name="form" xsi:type="string">product_form.product_form</item>
                    <item name="modal" xsi:type="string">cardgamemtg.setsModal</item>
                    <item name="nameStepWizard" xsi:type="string">select-secretlair-sets-steps-wizard</item>
                    <item name="dataScope" xsi:type="string">productFormSets</item>
                </argument>
            </arguments>
            <block class="Magento\Ui\Block\Component\StepsWizard" name="select-secretlair-sets-steps-wizard">
                <arguments>
                    <argument name="config" xsi:type="array">
                        <item name="form" xsi:type="string">product_form.product_form</item>
                        <item name="modal" xsi:type="string">cardgamemtg.setsModal</item>
                        <item name="dataScope" xsi:type="string">productFormSets</item>
                    </argument>
                </arguments>
                <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Steps\SelectDrop" name="step0" template="TCGCollective_MarketPlace::catalog/product/edit/drop/steps/select_drop.phtml">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">product_form.product_form</item>
                            <item name="modal" xsi:type="string">cardgamemtg.setsModal</item>
                            <item name="multiselectName" xsi:type="string">setsrelease_secretlair_drop_listing.setsrelease_secretlair_drop_listing.secretlair_drop_columns.ids</item>
                            <item name="providerName" xsi:type="string">setsrelease_secretlair_drop_listing.setsrelease_secretlair_drop_listing_data_source</item>
                            <item name="dataScope" xsi:type="string">productFormSets</item>
                        </argument>
                    </arguments>
                    <uiComponent name="setsrelease_secretlair_drop_listing"/>
                </block>
                <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Steps\SelectSets" name="step1" template="TCGCollective_MarketPlace::catalog/product/edit/sets/steps/select_secretlair_sets.phtml">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">product_form.product_form</item>
                            <item name="modal" xsi:type="string">cardgamemtg.setsModal</item>
                            <item name="multiselectName" xsi:type="string">setsrelease_secretlair_sets_listing.setsrelease_secretlair_sets_listing.secretlair_sets_columns.ids</item>
                            <item name="providerName" xsi:type="string">setsrelease_secretlair_sets_listing.setsrelease_secretlair_sets_listing_data_source</item>
                            <item name="dataScope" xsi:type="string">productFormSets</item>
                        </argument>
                    </arguments>
                    <uiComponent name="setsrelease_secretlair_sets_listing"/>
                </block>
                <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Steps\SelectSealedProducts" name="step.sealedproducts" template="TCGCollective_MarketPlace::catalog/product/edit/sets/steps/select_secretlair_sealedproducts.phtml">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">product_form.product_form</item>
                            <item name="modal" xsi:type="string">cardgamemtg.setsModal</item>
                            <item name="multiselectName" xsi:type="string">setsrelease_secretlair_sealedproducts_listing.setsrelease_secretlair_sealedproducts_listing.secretlair_sealedproducts_columns.ids</item>
                            <item name="providerName" xsi:type="string">setsrelease_secretlair_sealedproducts_listing.setsrelease_secretlair_sealedproducts_listing_data_source</item>
                            <item name="dataScope" xsi:type="string">productFormSets</item>
                        </argument>
                    </arguments>
                    <uiComponent name="setsrelease_secretlair_sealedproducts_listing"/>
                </block>
                <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Steps\SelectSingles" name="step2" template="TCGCollective_MarketPlace::catalog/product/edit/sets/steps/select_secretlair_singles.phtml">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">product_form.product_form</item>
                            <item name="modal" xsi:type="string">cardgamemtg.setsModal</item>
                            <item name="multiselectName" xsi:type="string">setsrelease_secretlair_singles_listing.setsrelease_secretlair_singles_listing.secretlair_singles_columns.ids</item>
                            <item name="providerName" xsi:type="string">setsrelease_secretlair_singles_listing.setsrelease_secretlair_singles_listing_data_source</item>
                            <item name="dataScope" xsi:type="string">productFormSets</item>
                        </argument>
                    </arguments>
                    <uiComponent name="setsrelease_secretlair_singles_listing"/>
                </block>
            </block>
        </block>
    </container>
</layout>
