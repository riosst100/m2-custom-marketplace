<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
	xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<body>

    <referenceContainer name="header.panel" remove="true" />
    <referenceBlock name="minicart" remove="true"/>
    <referenceBlock name="top.search" remove="true" />
    <referenceBlock name="page.main.title" remove="true"/>
    <referenceBlock name="seller.new" remove="true"/>

    <referenceContainer name="seller.login.container">
      <container name="cms_left_content_seller_login_container" label="cms left content seller login"
				htmlTag="div" htmlClass="cms-left-content-container">
				<block name="cms_left_content_seller_login" class="Magento\Framework\View\Element\Template" before="-" template="Lof_MarketPlace::seller/cms-left-content-seller-login.phtml"/>
			</container>
    </referenceContainer>
    

    <referenceContainer name="form.additional.info">
      <block class="Lof\SocialLogin\Block\Popup\Authentication" name="seller.addtional.infor.socials" template="Lof_SocialLogin::seller/form.phtml" before="-"/>
    </referenceContainer>

	</body>
</page>
