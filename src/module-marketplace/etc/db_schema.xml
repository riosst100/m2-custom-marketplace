    <!-- ============================= -->
    <!-- 1. marketplace_product_listing_category_config -->
    <!-- ============================= -->
    <table name="marketplace_product_listing_category_config" engine="innodb" comment="Marketplace Category Config">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Primary ID"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" comment="Magento Category ID"/>
        <column xsi:type="varchar" name="tab_attribute_code" nullable="false" length="64" comment="Tab Attribute Code"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <!-- category_id harus unique -->
        <constraint xsi:type="unique" referenceId="UNQ_MARKETPLACE_CAT_CONFIG_CATEGORY_ID">
            <column name="category_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_MARKETPLACE_CAT_CONFIG_CATEGORY"
                    table="marketplace_product_listing_category_config" column="category_id"
                    referenceTable="catalog_category_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
    <table name="marketplace_product_listing_category_column" engine="innodb" comment="Marketplace Category Default Columns">

    <column xsi:type="int" name="entity_id" padding="10" unsigned="true"
            nullable="false" identity="true" comment="Primary ID"/>

    <column xsi:type="int" name="category_config_id" unsigned="true"
            nullable="false" comment="Category Config ID"/>

    <column xsi:type="varchar" name="attribute_code"
            nullable="false" length="64" comment="Product Attribute Code"/>

    <column xsi:type="int" name="sort_order"
            nullable="false" default="0" comment="Sort Order"/>

    <column xsi:type="smallint" name="is_sortable"
            nullable="false" default="0" comment="Is Sortable"/>

    <column xsi:type="smallint" name="is_filterable"
            nullable="false" default="0" comment="Is Filterable"/>

    <column xsi:type="smallint" name="is_visible"
            nullable="false" default="1" comment="Is Visible"/>

    <!-- PRIMARY KEY -->
    <constraint xsi:type="primary" referenceId="PRIMARY">
        <column name="entity_id"/>
    </constraint>

    <!-- UNIQUE PER CATEGORY -->
    <constraint xsi:type="unique"
        referenceId="UNQ_MARKETPLACE_CATEGORY_COLUMN_PER_CATEGORY">
        <column name="category_config_id"/>
        <column name="attribute_code"/>
    </constraint>

    <!-- FOREIGN KEY -->
    <constraint xsi:type="foreign"
        referenceId="FK_MARKETPLACE_CATEGORY_COLUMN_CONFIG"
        table="marketplace_product_listing_category_column"
        column="category_config_id"
        referenceTable="marketplace_product_listing_category_config"
        referenceColumn="entity_id"
        onDelete="CASCADE"/>
</table>
    <!-- ============================= -->
    <!-- 2. marketplace_product_listing_category_tab -->
    <!-- ============================= -->
    <table name="marketplace_product_listing_category_tab" engine="innodb" comment="Marketplace Category Tabs">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Primary ID"/>
        <column xsi:type="int" name="category_config_id" unsigned="true" nullable="false" comment="Category Config ID"/>
        <column xsi:type="varchar" name="tab_value" nullable="false" length="64" comment="Tab Attribute Value"/>
        <column xsi:type="varchar" name="label" nullable="false" length="128" comment="Tab Label"/>
        <column xsi:type="int" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <!-- tab_value unique per category_config_id -->
        <constraint xsi:type="unique" referenceId="UNQ_MARKETPLACE_TAB_VALUE_PER_CATEGORY">
            <column name="category_config_id"/>
            <column name="tab_value"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_MARKETPLACE_TAB_CATEGORY_CONFIG"
                    table="marketplace_product_listing_category_tab" column="category_config_id"
                    referenceTable="marketplace_product_listing_category_config" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
    <!-- ====================================== -->
    <!-- 3. marketplace_product_listing_category_tab_column -->
    <!-- ====================================== -->
    <table name="marketplace_product_listing_category_tab_column" engine="innodb" comment="Marketplace Category Tab Columns">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Primary ID"/>
        <column xsi:type="int" name="tab_id" unsigned="true" nullable="false" comment="Tab ID"/>
        <column xsi:type="varchar" name="attribute_code" nullable="false" length="64" comment="Product Attribute Code"/>
        <column xsi:type="int" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_sortable" nullable="false" default="0" comment="Is Sortable"/>
        <column xsi:type="smallint" name="is_filterable" nullable="false" default="0" comment="Is Filterable"/>
        <column xsi:type="smallint" name="is_visible" nullable="false" default="1" comment="Is Visible"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <!-- attribute_code unique per tab_id -->
        <constraint xsi:type="unique" referenceId="UNQ_MARKETPLACE_TAB_COLUMN_PER_TAB">
            <column name="tab_id"/>
            <column name="attribute_code"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_MARKETPLACE_TAB_COLUMN_TAB"
                    table="marketplace_product_listing_category_tab_column" column="tab_id"
                    referenceTable="marketplace_product_listing_category_tab" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>

