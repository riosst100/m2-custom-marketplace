<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <fieldset name="template_information">
        <field name="email_receiver">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Sender</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">email_receiver</item>
                    <item name="sortOrder" xsi:type="number">55</item>
                    <item name="default" xsi:type="string">admin</item>
                </item>
            </argument>
            <settings>
                <options>
                    <option name="admin" xsi:type="array">
                        <item name="label" xsi:type="string" translate="true">Admin</item>
                        <item name="value" xsi:type="string">admin</item>
                    </option>
                    <option name="seller" xsi:type="array">
                        <item name="label" xsi:type="string" translate="true">Seller</item>
                        <item name="value" xsi:type="string">seller</item>
                    </option>
                </options>
            </settings>
        </field>
    </fieldset>

</form>
