<script>
  require([
    "jquery"
  ], function ($) {
        $(document).ready(function () {
      var ids = [];
      $('.delete-old').on('click', function (e) {
        e.preventDefault();
        var deleteId = $(this).attr('id');
        if (ids.indexOf(deleteId) === -1) {
          ids.push(deleteId);
        }
        $('[name="delete_ids"]').val(ids.join(','));
        $(this).closest('[data-role="attached-item"]').remove();
      });
        })
    });
</script>
