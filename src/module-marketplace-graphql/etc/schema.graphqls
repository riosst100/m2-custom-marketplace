  term_and_conditions: String @doc(description: "Term and conditions of the product.") @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Product\\TermAndConditions")
  custom_table_metadata: CustomTableMetadata @doc(description: "") @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Product\\CustomTableMetadata")
  shipping_policy: String @doc(description: "Shipping policy of the product.") @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Product\\ShippingPolicy")
  return_policy: String @doc(description: "Return policy of the product.") @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Product\\ReturnPolicy")
