<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="seller_visitor" resource="default" engine="innodb" comment="Visitor Table">
        <column xsi:type="bigint" name="visitor_id" unsigned="true" nullable="false" identity="true"
                comment="Visitor ID"/>
        <column xsi:type="int" name="customer_id" unsigned="false" nullable="true" identity="false"
                comment="Customer ID"/>
        <column xsi:type="int" name="seller_id" unsigned="false" nullable="true" identity="false"
                comment="Seller ID"/>
        <column xsi:type="varchar" name="session_id" nullable="true" length="1"
                comment="Deprecated: Session ID value no longer used"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="last_visit_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Last Visit Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="visitor_id"/>
        </constraint>
        <index referenceId="SELLER_VISITOR_SELLER_ID" indexType="btree">
            <column name="seller_id"/>
        </index>
        <index referenceId="SELLER_VISITOR_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="SELLER_VISITOR_LAST_VISIT_AT" indexType="btree">
            <column name="last_visit_at"/>
        </index>
    </table>
