                    <item name="required" xsi:type="boolean">true</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="entity_type" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">attributeoption_mapping</item>
                </item>
                <item name="options" xsi:type="array">
                    <item name="category" xsi:type="array">
                        <item name="label" xsi:type="string">Category</item>
                        <item name="value" xsi:type="string">category</item>
                    </item>
                    <item name="attribute" xsi:type="array">
                        <item name="label" xsi:type="string">Product Attribute</item>
                        <item name="value" xsi:type="string">attribute</item>
                    </item>
                </item>
            </argument>
            <settings>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>category</value>
                            <actions>
                                <action name="0">
                                    <target>productattributeslink_attributeoption_mapping_form.productattributeslink_attributeoption_mapping_form.attributeoption_mapping.attribute_code</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>productattributeslink_attributeoption_mapping_form.productattributeslink_attributeoption_mapping_form.attributeoption_mapping.category_id</target>
                                    <callback>show</callback>
                                </action>
                                 <action name="2">
                                    <target>productattributeslink_attributeoption_mapping_form.productattributeslink_attributeoption_mapping_form.attributeoption_mapping.attribute_option_id</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>attribute</value>
                            <actions>
                                <action name="0">
                                    <target>productattributeslink_attributeoption_mapping_form.productattributeslink_attributeoption_mapping_form.attributeoption_mapping.attribute_code</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>productattributeslink_attributeoption_mapping_form.productattributeslink_attributeoption_mapping_form.attributeoption_mapping.category_id</target>
