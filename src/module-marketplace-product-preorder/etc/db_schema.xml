<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- Quote Item -->
    <table name="quote_item" resource="checkout">
        <column name="is_preorder" xsi:type="smallint" nullable="true" default="0" comment="Is Preorder"/>
        <column name="pre_order_payment_type" xsi:type="varchar" length="20" nullable="true" comment="Preorder Payment Type"/>
        <column name="pre_order_deposit" xsi:type="int" default="0" nullable="true" comment="Preorder Deposit Percent"/>
    </table>

    <!-- Sales Order Item -->
    <table name="sales_order_item" resource="sales">
        <column name="is_preorder" xsi:type="smallint" nullable="true" default="0" comment="Is Preorder"/>
        <column name="pre_order_payment_type" xsi:type="varchar" length="20" nullable="true" comment="Preorder Payment Type"/>
        <column name="pre_order_deposit" xsi:type="int" default="0" nullable="true" comment="Preorder Deposit Percent"/>
    </table>

</schema>
