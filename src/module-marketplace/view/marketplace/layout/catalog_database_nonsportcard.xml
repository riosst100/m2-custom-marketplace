<?xml version="1.0"?>
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_layout.xsd">
    <container name="root">
        <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Edit\Tab\Sets\Config\NonSportCardMatrix" template="TCGCollective_MarketPlace::catalog/product/edit/super/nonsportcard-wizard-ajax.phtml" as="nonsportcard.wizard">
            <arguments>
                <argument name="config" xsi:type="array">
                    <item name="collapsible" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true" />
                    <item name="sortOrder" xsi:type="string">3333</item>
                    <item name="canShow" xsi:type="boolean">true</item>
                    <item name="componentType" xsi:type="string">fieldset</item>
                    <item name="form" xsi:type="string">product_form.product_form</item>
                    <item name="modal" xsi:type="string">nonsportcard.setsModal</item>
                    <item name="nameStepWizard" xsi:type="string">select-nonsportcard-sets-steps-wizard</item>
                    <item name="dataScope" xsi:type="string">productFormNonSportCardSets</item>
                </argument>
            </arguments>
            <block class="TCGCollective\MarketPlace\Block\Component\NonSportCardStepsWizard" name="select-nonsportcard-sets-steps-wizard">
                <arguments>
                    <argument name="config" xsi:type="array">
                        <item name="form" xsi:type="string">product_form.product_form</item>
                        <item name="modal" xsi:type="string">nonsportcard.setsModal</item>
                        <item name="dataScope" xsi:type="string">productFormNonSportCardSets</item>
                    </argument>
                </arguments>
                <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Steps\NonSportCardSelectSets" name="step1" template="TCGCollective_MarketPlace::catalog/product/edit/sets/steps/select_nonsportcard_sets.phtml">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">product_form.product_form</item>
                            <item name="modal" xsi:type="string">nonsportcard.setsModal</item>
                            <item name="multiselectName" xsi:type="string">nonsportcard_sets_listing.nonsportcard_sets_listing.nonsportcard_sets_columns.ids</item>
                            <item name="providerName" xsi:type="string">nonsportcard_sets_listing.nonsportcard_sets_listing_data_source</item>
                            <item name="dataScope" xsi:type="string">productFormNonSportCardSets</item>
                        </argument>
                    </arguments>
                    <uiComponent name="nonsportcard_sets_listing"/>
                </block>
                <block class="TCGCollective\MarketPlace\Block\Adminhtml\Product\Steps\NonSportCardSelectSingles" name="step2" template="TCGCollective_MarketPlace::catalog/product/edit/sets/steps/select_nonsportcard_singles.phtml">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">product_form.product_form</item>
                            <item name="modal" xsi:type="string">nonsportcard.setsModal</item>
                            <item name="multiselectName" xsi:type="string">nonsportcard_singles_listing.nonsportcard_singles_listing.nonsportcard_singles_columns.ids</item>
                            <item name="providerName" xsi:type="string">nonsportcard_singles_listing.nonsportcard_singles_listing_data_source</item>
                            <item name="dataScope" xsi:type="string">productFormNonSportCardSets</item>
                        </argument>
                    </arguments>
                    <uiComponent name="nonsportcard_singles_listing"/>
                </block>
            </block>
        </block>
    </container>
</layout>
