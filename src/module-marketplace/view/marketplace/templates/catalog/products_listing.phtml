function getAvailabilityHtml(status, initialStatus, isDefaultCountryPublished = true) {

    if (status == 1 && initialStatus == 1) {
        return `
            <div class="publish-info info-available">
                This product is published and available in this country.
            </div>
        `;
    }

    if (status == 1 && initialStatus != 1) {
        return `
            <div class="publish-info info-will-available">
                This product will be published and available in this country after saving the changes.
            </div>
        `;
    }

    if (status != 1 && initialStatus == 1) {
        return `
            <div class="publish-info info-will-removed">
                This product will be unpublished and no longer available in this country after saving the changes.
            </div>
        `;
    }

    if (!isDefaultCountryPublished) {
        return `
            <div class="publish-info info-not-available">
                Please set the Default Country status to Published and enter the product price first.
            </div>
        `;
    }

    return `
        <div class="publish-info info-not-available">
            This product is currently unpublished and not available in this country.
        </div>
    `;
}

function generateWebsiteCards() {

    const container = $('#website-card-container');
    container.empty();

    const samePrice = $('#same-price-toggle').is(':checked');
    initiallyPublished = [];

    websiteData.forEach(site => {
        if (!site.allowed) {
            return;
        }
        const checkedAttr = site.published ? 'checked' : '';
        const disabledAttr = site.allowed ? '' : 'disabled';
        const priceValue = site.price ? site.price : '';
        const lockedClass = site.is_default_country_published || site.is_default ? '' : 'locked';
        // const lockedClass = false;

        const isPublished = site.published == 1;
        const isDefaultCountryPublished = site.is_default_country_published || site.is_default ? true : false;        

        if (site.published == 1) {
            initiallyPublished.push(site.name);
        }

        const initialStatus = isPublished ? 1 : 2;

const availabilityHtml = getAvailabilityHtml(initialStatus, initialStatus, isDefaultCountryPublished);


const card = `
    <div class="website-card ${lockedClass}" data-id="${site.id}" data-initial-status="${initialStatus}">
        <div class="website-card-header">
            <div class="website-card-title">
                ${site.name}
                <span class="currency-info">(${site.currency})${site.is_default ? ' - Default Country' : ''}</span>
            </div>
        </div>

        <div class="website-card-price">
            <div class="publish-input-container">

                <!-- STATUS -->
                <div>
                    <div class="input-label">Status:</div>
                    <select class="select2-without-search status-select" 
                            data-id="${site.id}" ${lockedClass ? 'disabled' : ''}>
                        <option value="2" ${!isPublished ? 'selected' : ''}>Draft</option>
                        <option value="1" ${isPublished ? 'selected' : ''}>Published</option>
                    </select>
                </div>

                <!-- PRICE -->
                <div class="price-container" 
                     data-id="${site.id}" 
                     style="width:100%;">
                    <div class="input-label">Price:</div>
                    <div class="price-wrapper" data-currency="${site.currency}">
                        <input 
                            type="text"
                            class="price-input"
                            data-id="${site.id}"
                            value="${priceValue}"
                            ${!isPublished ? 'disabled' : ''}
                        />
                    </div>
                    <div class="error-message price-error" data-id="${site.id}">
                        Price is required for published products.
                    </div>
                </div>
                

            </div>
        </div>
        ${availabilityHtml}
    </div>
`;

        container.append(card);
    });

    $('.select2-without-search').select2({
        allowClear: false,
        minimumResultsForSearch: Infinity,
        width: 'resolve'
    });

    togglePriceMode();
    updatePublishInfo();
}

// Toast notification function
function showToast(message, type = 'success', duration = 3000) {
    const toast = $(`
        <div class="toast-notification ${type}">${message}</div>
    `);
    
    $('body').append(toast);
    
    setTimeout(() => {
        toast.addClass('closing');
        setTimeout(() => {
            toast.remove();
        }, 300);
    }, duration);
}

// Clear modal errors
function clearModalErrors() {
    $('#modal-error-box').removeClass('show');
    $('#modal-error-list').empty();
}

// Show modal errors
function showModalErrors(errors) {
    const errorList = $('#modal-error-list');
    errorList.empty();
    
    errors.forEach(error => {
        errorList.append(`<li>${error}</li>`);
    });
    
    $('#modal-error-box').addClass('show');
}

// Validate prices before submit
function validatePublishData() {
    const errors = [];
    let hasPublishedWebsites = false;
    
    $('.website-card').each(function () {
        const siteId = $(this).data('id');
        const status = $(`.status-select[data-id="${siteId}"]`).val();
        const price  = $(`.price-input[data-id="${siteId}"]`).val();
        const priceError = $(this).find(`.price-error[data-id="${siteId}"]`);
        const $priceInput = $(this).find(`.price-input[data-id="${siteId}"]`);
        
        if (status == 1) {
            hasPublishedWebsites = true;
            if (!price) {
                // Tampilkan error di bawah input field
                priceError.text('Price is required for published website.').addClass('show');
                $priceInput.addClass('error');
            } else {
                priceError.removeClass('show');
                $priceInput.removeClass('error');
            }
        } else {
            priceError.removeClass('show');
            $priceInput.removeClass('error');
        }
    });
    
    // Hanya validasi untuk "select at least one country" di banner
    if (!hasPublishedWebsites) {
        errors.push('Please select at least one country with Published status.');
    }
    
    return {
        valid: errors.length === 0 && $('.price-error.show').length === 0,
        errors: errors
    };
}

let convertTimer;

$(document).on('input', '.price-input', function(){

    clearTimeout(convertTimer);

    const card = $(this).closest('.website-card');

    const isDefault = card.find('.currency-info').text().includes('Default Country');

    if(!isDefault){
        return;
    }

    const price = $(this).val();

    if(!price){
        return;
    }

    convertTimer = setTimeout(function(){

        const baseCurrency = card.find('.price-wrapper').data('currency');

        let targetCurrencies = [];

        $('.website-card').each(function(){

            const currency = $(this).find('.price-wrapper').data('currency');

            if(currency !== baseCurrency){
                targetCurrencies.push(currency);
            }

        });

        convertCurrency(price, baseCurrency, targetCurrencies);

    }, 400);

});

function convertCurrency(price, baseCurrency, targetCurrencies){

    // show loader
    $('.website-card').each(function(){

        const currency = $(this).find('.price-wrapper').data('currency');

        if(currency !== baseCurrency){
            $(this).find('.price-wrapper').addClass('price-loading');
        }

    });

    $.ajax({
        url: '<?= $block->getUrl("catalog/products_grid/convertCurrency") ?>',
        type: 'POST',
        data: {
            price: price,
            base_currency: baseCurrency,
            currencies: targetCurrencies
        },
        success: function(response){

            if(!response.success){
                return;
            }

            const prices = response.prices;

            $('.website-card').each(function(){

                const currency = $(this).find('.price-wrapper').data('currency');

                if(prices[currency]){

                    $(this).find('.price-input').val(prices[currency]);

                    // 🔓 UNLOCK COUNTRY
                    $(this).removeClass('locked');

                    $(this).find('.status-select').prop('disabled', false);

                    // price tetap disabled kalau status Draft
                    if($(this).find('.status-select').val() == 1){
                        $(this).find('.price-input').prop('disabled', false);
                    }

                }

            });

        },
        complete: function(){

            // remove loader
            $('.price-wrapper').removeClass('price-loading');

        }
    });
}

function updatePublishInfo() {

    let currentPublished = [];

    $('.website-card').each(function () {

        const siteId = $(this).data('id');
        const status = $(`.status-select[data-id="${siteId}"]`).val();
        const siteName = $(this)
            .find('.website-card-title')
            .clone()
            .children()
            .remove()
            .end()
            .text()
            .trim();

        if (status == 1) {
            currentPublished.push(siteName);
        }
    });

    const existingBox = $('.publish-existing');
    const newBox = $('.publish-new');

    const existingMessage = $('.publish-existing-message');
    const newMessage = $('.publish-new-message');

    // =============================
    // 1️⃣ EXISTING (SUDAH PUBLISH)
    // =============================
    if (initiallyPublished.length > 0) {

        existingMessage.html(`
            Saat ini produk ini sudah publish dan tersedia di countries:
            ${initiallyPublished.join(', ')}
        `);

        existingBox.show();

    } else {
        existingBox.hide();
    }

    // =============================
    // 2️⃣ NEWLY PUBLISHED
    // =============================

    const newlyPublished = currentPublished.filter(
        country => !initiallyPublished.includes(country)
    );

    if (newlyPublished.length > 0) {

        newMessage.html(`
            Produk ini akan dipublish ke countries:
            ${newlyPublished.join(', ')}
        `);

        newBox.show();

    } else {
        newBox.hide();
    }
}

// Toggle price when status changed
$(document).on('change', '.status-select', function () {

    const siteId = $(this).data('id');
    const status = $(this).val();

    const card = $(`.website-card[data-id="${siteId}"]`);
    const initialStatus = card.data('initial-status');
    const priceContainer = card.find('.price-input');
    const priceError = card.find(`.price-error[data-id="${siteId}"]`);

    const infoHtml = getAvailabilityHtml(status, initialStatus);

    card.find('.publish-info').replaceWith(infoHtml);

    if (status == 1) {
        priceContainer.prop('disabled', false);
    } else {
        priceContainer.prop('disabled', true);
        priceError.removeClass('show');
    }
});

// Validate price on input change
$(document).on('input', '.price-input', function(){
    
    const siteId = $(this).data('id');
    const card = $(`.website-card[data-id="${siteId}"]`);
    const status = card.find(`.status-select[data-id="${siteId}"]`).val();
    const priceError = card.find(`.price-error[data-id="${siteId}"]`);
    const $priceInput = $(this);
    const value = $priceInput.val();
    
    if (status == 1 && !value) {
        priceError.addClass('show');
        $priceInput.addClass('error');
    } else {
        priceError.removeClass('show');
        $priceInput.removeClass('error');
    }
});

