<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                seller_group_listing.seller_group_listing_data_source
            </item>
        </item>
    </argument>

    <settings>
        <buttons>
            <button name="add">
                <url path="marketplace/sellergroup/new"/>
                <class>primary</class>
                <label translate="true">Add New Seller Group</label>
            </button>
        </buttons>
        <spinner>customer_group_columns</spinner>
        <deps>
            <dep>seller_group_listing.seller_group_listing_data_source</dep>
        </deps>
    </settings>

    <!-- DATA SOURCE -->
    <dataSource name="seller_group_listing_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">customer_group_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>

        <aclResource>Magento_Customer::group</aclResource>

        <!-- <dataProvider
            class="TCGCollective\MarketPlace\Model\SellerGroup\DataProvider"
            name="seller_group_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>customer_group_id</primaryFieldName>
            </settings>
        </dataProvider> -->
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="seller_group_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>customer_group_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <!-- TOOLBAR -->
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <!-- COLUMNS -->
    <columns name="customer_group_columns">
        <column name="customer_group_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="componentDisabled" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="customer_group_code">
            <settings>
                <filter>text</filter>
                <label translate="true">Group</label>
            </settings>
        </column>

        <column name="tax_class_id"
                component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="componentDisabled" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <options class="Magento\Tax\Model\TaxClass\Source\Customer"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Tax Class</label>
            </settings>
        </column>

        <actionsColumn name="actions"
                       class="TCGCollective\MarketPlace\Ui\Component\Listing\Columns\SellerGroupActions">
            <settings>
                <indexField>customer_group_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
