        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">productattributeslink_brands_form.productattributeslink_brands_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Cart Price Rule</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="delete" class="TCGCollective\ProductAttributesLink\Block\Adminhtml\Generic\DeleteButton"/>
