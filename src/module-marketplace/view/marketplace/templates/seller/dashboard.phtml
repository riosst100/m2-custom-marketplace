    <script>
        require([
            "jquery",
            "Lof_MarketPlace/js/raphael",
            "Lof_MarketPlace/js/morris",
            "Lof_MarketPlace/js/jquery.vmap",
            "Lof_MarketPlace/js/jquery.vmap.world",
            "Lof_MarketPlace/js/jquery.vmap.sampledata",
            "mage/calendar"
        ], function ($) {
            $("#from_date, #to_date").calendar({
                dateFormat: "yy-mm-dd"
            });

            // Show/hide custom date inputs
            $("#date-range").on("change", function () {
                if ($(this).val() === "Custom Date Range") {
                    $("#custom-date-container").show();
                } else {
                    $("#custom-date-container").hide();
                    updateReport(); // trigger immediately for non-custom
                }
            });

            function updateReport() {
                var dateRange = $('#date-range').val();

                // If custom, wait for both dates
                if (dateRange === "Custom Date Range") {
                    var from = $("#from_date").val();
                    var to   = $("#to_date").val();

                    // Prevent early trigger
                    if (!from || !to) {
                        return; 
                    }
                }

                var data = {
                    country: $('#country').val(),
                    category: $('#category').val(),
                    date: dateRange
                };

                if (dateRange === "Custom Date Range") {
                    data.from_date = $("#from_date").val();
                    data.to_date   = $("#to_date").val();
                }

                $.ajax({
                    url: '<?= $block->getUrl("catalog/dashboard/ajax") ?>',
                    type: 'POST',
                    dataType: 'json',
                    data: data,
                    showLoader: true,
                    success: function (response) {
                        if (response.success) {
                            $('#dashboard-ajax').html(response.html);
                        }
                    }
                });
            }

            // Trigger update for normal filters
            $("#country, #category").on("change", updateReport);

            // Trigger update **only after both dates chosen**
            $("#from_date, #to_date").on("change", function () {
                if ($("#date-range").val() === "Custom Date Range") {
                    updateReport();
                }
            });
            
            $('#country, #category, #date-range').on('change', updateReport);

