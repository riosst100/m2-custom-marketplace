        element.scrollIntoView({ behavior: "smooth" });
    }
</script>
<script type="text/javascript">
    require([
        "jquery"
    ], function ($) {
        function activatePayment() {
            var method = $(this).data('method');

            $.ajax({
                url: '<?= $block->getUrl("catalog/payment/activate") ?>',
                type: 'POST',
                dataType: 'json',
                data: {
                    method: method
                },
                showLoader: true,
                success: function(response) {
                    if (response.success) {
                        $('#cancel-payment-' + method).show();
                        $('#activate-payment-' + method).hide();

                        $('#activate-payment-container').html(response.html).slideDown();
                        // activate-payment-container
                        $('html, body').animate({
                            scrollTop: $('#activate-payment-container').offset().top
                        }, 600); // durasi 600ms
                    }
                }
            });
        }

        $('.activate-payment').on('click', activatePayment);

        $('.cancel-payment').on('click', function(){
            var method = $(this).data('method');
            $('#cancel-payment-' + method).hide();
            $('#activate-payment-container').slideUp();
            $('#activate-payment-' + method).show();
        });

        $(".field-lofmpproductshipping-title").css('display', 'none');
        $("#lofmpproductshipping-name").attr('placeholder', 'Standard Shipping');
        $("#lofmpproductshipping-name").keyup(function (){
            var methodName = $(this).val();
            $("#lofmpproductshipping-title").val(methodName);
        })
        var methodName1 = $("#lofmpproductshipping-name").val();
        $("#lofmpproductshipping-title").val(methodName1);
        $('#lofmptablerateshipping-active option[value="1"]').attr('selected', false);
        $('#lofmpflatrateshipping-active option[value="1"]').attr('selected', false);
        $('#lofmpproductshipping-active option[value="1"]').attr('selected', false);
        if ($("h2").length > 0) {
            $("h2").addClass("lof_shipping");
        }
    });
</script>
