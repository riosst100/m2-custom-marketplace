<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>

        <!-- REMOVE ID COLUMN -->
        <referenceBlock
            name="adminhtml.system.email.template.grid.columnSet.template_id"
            remove="true"
        />

        <!-- REMOVE SUBJECT COLUMN -->
        <referenceBlock
            name="adminhtml.system.email.template.grid.columnSet.subject"
            remove="true"
        />

        <!-- ADD CUSTOM COLUMNS -->
        <referenceBlock name="adminhtml.system.email.template.grid.columnSet">

            <!-- EMAIL RECEIVER -->
            <block class="Magento\Backend\Block\Widget\Grid\Column"
                   name="adminhtml.system.email.template.grid.columnSet.email_receiver"
                   as="email_receiver">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">
                        Email Receiver
                    </argument>
                    <argument name="index" xsi:type="string">
                        email_receiver
                    </argument>
                    <argument name="renderer" xsi:type="string">
                        TCGCollective\MarketPlace\Block\Adminhtml\Template\Grid\Renderer\EmailReceiver
                    </argument>
                    <argument name="filter" xsi:type="string">
                        TCGCollective\MarketPlace\Block\Adminhtml\Template\Grid\Filter\EmailReceiver
                    </argument>
                </arguments>
            </block>

            <!-- WEBSITE -->
            <block class="Magento\Backend\Block\Widget\Grid\Column"
                   name="adminhtml.system.email.template.grid.columnSet.website_id"
                   as="website_id">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">
                        Countries/Regions
                    </argument>
                    <argument name="index" xsi:type="string">
                        website_id
                    </argument>
                    <argument name="renderer" xsi:type="string">
                        TCGCollective\MarketPlace\Block\Adminhtml\Template\Grid\Renderer\Website
                    </argument>
                    <argument name="filter" xsi:type="string">
                        TCGCollective\MarketPlace\Block\Adminhtml\Template\Grid\Filter\Website
                    </argument>
                </arguments>
            </block>

        </referenceBlock>

        <!-- ACTION COLUMN (LAST) -->
        <referenceBlock name="adminhtml.system.email.template.grid.columnSet.action">
            <arguments>
                <argument name="renderer" xsi:type="string">
                    TCGCollective\MarketPlace\Block\Adminhtml\Template\Grid\Renderer\Action
                </argument>
            </arguments>
        </referenceBlock>

    </body>
</page>
