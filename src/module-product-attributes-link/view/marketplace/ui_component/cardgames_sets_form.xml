    </argument>
    <dataSource name="cardgames_sets_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TCGCollective\ProductAttributesLink\Ui\DataProvider\Form\CardGamesSetsDataProvider</argument>
            <argument name="name" xsi:type="string">cardgames_sets_form_data_source</argument>
