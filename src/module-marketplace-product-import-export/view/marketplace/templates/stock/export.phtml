<script>
    require([
        "jquery",
        "mage/mage",
        "select2"
    ], function ($) {
        $(document).ready(function() {

            var fileUrl = '';

            const pageSize = <?= $pageSize ?>;
            const currentPage = <?= $currentPage ?>;

            MST.updateHistory(currentPage, pageSize, true);

            // DOWNLOAD TEMPLATE
            $('#export_data_btn').on('click', function() {
                var formData = new FormData($('#edit_form')[0]);
                $.ajax({
                    type: "POST",
                    url: "<?= $block->escapeJs($block->getUrl('*/export/processExport')) ?>",
                    data: formData,
                    async: true,
                    cache: false,
                    contentType: false,
                    enctype: 'multipart/form-data',
                    processData: false,
                    showLoader: false,
                    beforeSend: function () {},
                    xhr: function() {
                        var xhr = new window.XMLHttpRequest();
                        var lastPercentComplete = 0; // Track the last percentage to throttle updates
                        var updateDelay = 100; // Delay in milliseconds for updates
                        var updateInterval = 500; // Interval to check progress in milliseconds

                        // Function to update the progress bar
                        function updateProgressBar(percentComplete) {
                            $('#progress-bar').css('width', percentComplete + '%');
                            lastPercentComplete = percentComplete; // Update the last tracked percentage
                        }

                        // Set initial width to 0% and show the progress container
                        // $('#progress-bar').css('width', '0%');
                        // $('#progress-container').show();

                        $('#progress-bar').css('width', '0%');
                        lastPercentComplete = 0; // Reset the last percent complete tracker
                        $('#progress-container').show();

                        // Upload progress
                        xhr.upload.addEventListener("progress", function(evt) {
                            if (evt.lengthComputable) {
                                var percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                // Update the progress bar only if the percentage has changed significantly
                                if (percentComplete - lastPercentComplete >= 20) { // Update every 20%
                                    setTimeout(function() {
                                        updateProgressBar(percentComplete);
                                    }, updateDelay); // Delay the update
                                }
                            }
                        }, false);

                        // Use a timer to check progress every updateInterval milliseconds
                        setInterval(function() {
                            if (lastPercentComplete < 100) {
                                updateProgressBar(lastPercentComplete); // Ensure the progress bar is updated
                            }
                        }, updateInterval);

                        return xhr;
                    },
                    success: function (html) {
                        const pageSize = parseInt($('#upload_history .paginator .page-size').text()) ?? null;
                        const currentPage = parseInt($('#upload_history .pagination .current-page').text()) ?? null;

                        MST.updateHistory(currentPage, pageSize, false, true, true);
                        // currentPage = 1, pageSize = 5, showLoader = true, startImport = false, afterUpload = false
                    }
                });
            });
            
            $('#categories').on('change', function() {
                if ($(this).val()) {
                    $('#export_data_btn').attr('disabled', false);
                } else {
                    $('#export_data_btn').attr('disabled', true);
                }
            });
            
            function showHistory() {
                $('#upload_history').slideDown(1000);
                $('#hide_upload_history').show();

                // var targetRow = $('#upload_history');
                // if (targetRow.length) {
                //     var offset = targetRow.offset().top;
                //     $('html, body').animate({
                //         scrollTop: offset-200
                //     }, 500); 
                // }
            }

            var data = <?= $block->getCategoriesData() ?>;
            $('#categories').select2(
                {
                    data: data,
                    width: 'resolve'
                }
            );
        });
        
        var dataForm = $('#edit_form');
        dataForm.mage('validation', {});
        var _action = dataForm.attr('action');
        $('#entity').change(function () {
            if ($(this).val() == 'catalog_product') {
                $('.fieldset_behavior,.fieldset_import').show();
            } else {
                $('.fieldset_behavior,.fieldset_import').hide();
            }
        });
        
        MST = {
            changePage: function(page) {
                const pageSize = document.querySelector('.page-size').value;
                MST.updateHistory(page, pageSize);
            },
            changePageSize: function(size) {
                const currentPage = parseInt($('.pagination .current-page').text());
                MST.updateHistory(currentPage, size);
            },
            updateHistory: function (currentPage = 1, pageSize = 5, showLoader = true, startImport = false, afterUpload = false) {
                $.ajax({
                    type: "GET",
                    cache: false,
                    showLoader:showLoader,
                    url: "<?= $block->escapeJs($block->getUrl('*/export/updateExportHistory')) ?>",
                    data: {
                        page: currentPage,
                        size: pageSize,
                        entity: 'stock'
                    },
                    beforeSend: function () {},
                    success: function (html) {
                        // Hide the progress bar on success
                        $('#progress-container').slideUp();
                        
                        $('#upload_history').html(html);
                        $('#upload_history').slideDown(1000);
                        $('#hide_upload_history').show();
                        $('#show_upload_history').hide();

                        

                        // Get all tr elements in tbody
                        if (afterUpload) {
                            $('#upload_history tbody tr:first').find('td').each(function() {
                                // For each td in the first tr, set background color
                                $(this).css('background-color', '#e5f7fe');

                                setTimeout(() => {
                                    $(this).css('background-color', 'white');
                                }, 2000);
                            });

                            // var targetRow = $('#upload_history');
                            // if (targetRow.length) {
                            //     var offset = targetRow.offset().top;
                            //     $('html, body').animate({
                            //         scrollTop: offset-200
                            //     }, 500); 
                            // }
                        }

                        // $("a#trigger").trigger('mouseenter');
                    }
                });
            },
            validateImport: function () {
                if ($('#edit_form').valid()) {
                    var fileInput = document.getElementById('import_file');
                    var filePath = fileInput.value;
                    var allowedExtensions = /(\.csv)$/i;

                    if (!allowedExtensions.exec(filePath)) {
                        alert('Only CSV files allowed.');
                        fileInput.value = ''; // Clear the input
                        return false;
                    }
                    //grab all form data
                    var formData = new FormData($('#edit_form')[0]);
                    
                    // Show the progress bar
                    $('#progress-bar').css('width', '0%');
                    $('#progress-container').slideDown();

                    $.ajax({
                        type: "POST",
                        url: "<?= $block->escapeJs($block->getUrl('*/*/validateimport/')) ?>",
                        data: formData,
                        async: true,
                        cache: false,
                        contentType: false,
                        enctype: 'multipart/form-data',
                        processData: false,
                        showLoader: false,
                        beforeSend: function () {},
                        xhr: function() {
                            var xhr = new window.XMLHttpRequest();
                            var lastPercentComplete = 0; // Track the last percentage to throttle updates
                            var updateDelay = 100; // Delay in milliseconds for updates
                            var updateInterval = 500; // Interval to check progress in milliseconds

                            // Function to update the progress bar
                            function updateProgressBar(percentComplete) {
                                $('#progress-bar').css('width', percentComplete + '%');
                                lastPercentComplete = percentComplete; // Update the last tracked percentage
                            }

                            // Set initial width to 0% and show the progress container
                            // $('#progress-bar').css('width', '0%');
                            // $('#progress-container').show();

                            $('#progress-bar').css('width', '0%');
                            lastPercentComplete = 0; // Reset the last percent complete tracker
                            $('#progress-container').show();

                            // Upload progress
                            xhr.upload.addEventListener("progress", function(evt) {
                                if (evt.lengthComputable) {
                                    var percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                    // Update the progress bar only if the percentage has changed significantly
                                    if (percentComplete - lastPercentComplete >= 20) { // Update every 20%
                                        setTimeout(function() {
                                            updateProgressBar(percentComplete);
                                        }, updateDelay); // Delay the update
                                    }
                                }
                            }, false);

                            // Use a timer to check progress every updateInterval milliseconds
                            setInterval(function() {
                                if (lastPercentComplete < 100) {
                                    updateProgressBar(lastPercentComplete); // Ensure the progress bar is updated
                                }
                            }, updateInterval);

                            return xhr;
                        },
                        success: function (html) {
                            const pageSize = parseInt($('#upload_history .paginator .page-size').text()) ?? null;
                            const currentPage = parseInt($('#upload_history .pagination .current-page').text()) ?? null;

                            MST.updateHistory(currentPage, pageSize, false, true);
                        }
                    });
                }
            }
        }
    });
</script>
