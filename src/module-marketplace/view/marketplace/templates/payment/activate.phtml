        $('#proceed_payment').click(function(e){
            e.preventDefault();
            
            var account_id = $('#account_id').val();
            var method = $('#payment_method').val();
            var request_amount = $('#request_amount').val();
            var currency = $('#currency').val();

            $.ajax({
                url: '<?= $block->getUrl('catalog/payment/testpayment') ?>',
                type: 'POST',
                dataType: 'json',
                showLoader: 'true',
                data: {
                    request_amount: request_amount,
                    payment_method: method,
                    currency: currency,
                    account_id: account_id,
                    form_key: window.FORM_KEY
                },
                success: function(response) {
                    // alert('You have sent email to '+contactname);
                    // location.reload();
                    // console.log(response)
                    if (response.html) {
                        $('#activate-payment-container').html(response.html);
                        // activate-payment-container
                        $('html, body').animate({
                            scrollTop: $('#activate-payment-container').offset().top
                        }, 600); // durasi 600ms
                    }

                    if (response.error_message) {
                        $('#error_msg_container').slideDown();
                        $('#error_msg_text').text(response.error_message);
                    } else {
                        $('#error_msg_container').slideUp();
                        $('#error_msg_text').text('');
                    }

                    if (response.success_message) {
                        $('#success_msg_container').slideDown();
                        $('#success_msg_text').text(response.success_message);
                    } else {
                        $('#success_msg_container').slideUp();
                        $('#success_msg_text').text('');
                    }
                },
                // error: function (xhr, status, errorThrown) {
                //     alert('Error happens. Try again.');
                // }
            });
        });

