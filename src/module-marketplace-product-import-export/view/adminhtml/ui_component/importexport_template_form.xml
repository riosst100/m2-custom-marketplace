<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">importexport_template_form.importexport_template_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Cart Price Rule</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="delete" class="TCGCollective\ProductAttributesLink\Block\Adminhtml\Generic\DeleteButton"/>
            <button name="save" class="Magento\SalesRule\Block\Adminhtml\Promo\Quote\Edit\SaveButton"/>
            <button name="back" class="TCGCollective\ProductAttributesLink\Block\Adminhtml\AttributeOption\Back"/>
        </buttons>
        <namespace>importexport_template_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>importexport_template_form.importexport_template_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="importexport_template_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="TCGCollective\MarketplaceProductImportExport\Ui\DataProvider\Form\ImportExportTemplateDataProvider" name="importexport_template_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="importexport_template" sortOrder="10">
        <settings>
            <collapsible>false</collapsible>
            <opened>true</opened>
            <label translate="true"></label>
        </settings>
        <!-- <field name="group">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Group Name</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">group</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field> -->
        <field name="entity_type" formElement="select">
            <argument name="data" xsi:type="array">
                <!-- <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">importexport_template</item>
                </item> -->
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">importexport_template</item>
                    <item name="label" xsi:type="string" translate="true">Mapping By</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="component" xsi:type="string">Magento_Catalog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                    <item name="required" xsi:type="boolean">false</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="listens" xsi:type="array">
                        <item name="${ $.namespace }.${ $.namespace }:responseData" xsi:type="string">setParsed</item>
                    </item>
                </item>
                <item name="options" xsi:type="array">
                    <item name="category" xsi:type="array">
                        <item name="label" xsi:type="string">Category</item>
                        <item name="value" xsi:type="string">category</item>
                    </item>
                    <item name="attribute" xsi:type="array">
                        <item name="label" xsi:type="string">Product Attribute</item>
                        <item name="value" xsi:type="string">attribute</item>
                    </item>
                </item>
            </argument>
            <settings>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>category</value>
                            <actions>
                                <action name="0">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.attribute_code</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.category_id</target>
                                    <callback>show</callback>
                                </action>
                                 <action name="2">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.attribute_option_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.template</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>attribute</value>
                            <actions>
                                <action name="0">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.attribute_code</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.category_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.attribute_option_id</target>
                                    <callback>show</callback>
                                </action>
                                <action name="3">
                                    <target>importexport_template_form.importexport_template_form.importexport_template.template</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <visible>true</visible>
                <dataScope>entity_type</dataScope>
            </settings>
        </field>
        <field name="attribute_code">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">TCGCollective\MarketplaceProductImportExport\Model\Source\AttributeCode</item>
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">attributeset_mapping</item>
                    <item name="label" xsi:type="string" translate="true">Attribute Code</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="component" xsi:type="string">Magento_Catalog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                    <item name="required" xsi:type="boolean">false</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="listens" xsi:type="array">
                        <item name="${ $.namespace }.${ $.namespace }:responseData" xsi:type="string">setParsed</item>
                    </item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Attribute Code</label>
                <visible>false</visible>
                <dataScope>attribute_code</dataScope>
            </settings>
        </field>
        <field name="attribute_option_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">TCGCollective\ProductAttributesLink\Model\Source\AttributeOptions</item>
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">attributeset_mapping</item>
                    <item name="label" xsi:type="string" translate="true">Attribute Option</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="component" xsi:type="string">Magento_Catalog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="required" xsi:type="boolean">false</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="listens" xsi:type="array">
                        <item name="${ $.namespace }.${ $.namespace }:responseData" xsi:type="string">setParsed</item>
                    </item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <dataScope>attribute_option_id</dataScope>
            </settings>
        </field>
        <field name="category_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Catalog\Ui\Component\Product\Form\Categories\Options</item>
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">importexport_template</item>
                    <item name="label" xsi:type="string" translate="true">Category</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Catalog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                    <item name="required" xsi:type="boolean">false</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="listens" xsi:type="array">
                        <item name="${ $.namespace }.${ $.namespace }:responseData" xsi:type="string">setParsed</item>
                    </item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Category</label>
                <visible>false</visible>
                <dataScope>category_id</dataScope>
            </settings>
        </field>
        <file name="template">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">importexport_template</item>
                    <item name="label" xsi:type="string">Select Template File</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="required" xsi:type="boolean">false</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">false</item>
                    </item>
                </item>
            </argument>
        </file>
    </fieldset>
</form>
