function togglePriceMode() {

    const samePrice = $('#same-price-toggle').is(':checked');

    if (samePrice) {
        const firstPrice = $('.website-price').first();

        $('.website-price').not(firstPrice).prop('disabled', true);

        firstPrice.on('input', function(){
            const val = $(this).val();
            $('.website-price').val(val);
        });
    } else {
        $('.website-price').prop('disabled', false);
        $('.website-price').off('input');
    }
}


// SUBMIT PUBLISH
function submitPublish() {

    clearModalErrors();
    
    // Validate
    const validation = validatePublishData();
    
    if (!validation.valid) {
        // Hanya tampilkan modal errors jika ada error yang perlu ditampilkan di banner
        // (error "Please select at least one country" bukan price error)
        if (validation.errors.length > 0) {
            showModalErrors(validation.errors);
        }
        return;
    }

    let publishData = [];

    $('.website-card').each(function () {

        const siteId = $(this).data('id');
        const status = $(`.status-select[data-id="${siteId}"]`).val();
        const price  = $(`.price-input[data-id="${siteId}"]`).val();

        // HANYA ambil yg status = Published (1)
        if (status == 1) {
            publishData.push({
                website_id: siteId,
                status: 1,
                price: price
            });
        }

    });

    // START LOADING
    const publishBtn = $('.modal-footer .btn-primary');
    publishBtn.addClass('btn-loading');
    publishBtn.text('Publishing...');

    $.ajax({
        url: '<?= $block->getUrl("catalog/products_grid/savePublish") ?>',
        type: 'POST',
        data: {
            product_id: currentProductId,
            websites: publishData
        },
        success: function (response) {
            if (response.success) {
                showToast('Product published successfully!', 'success');
                table.ajax.reload();
                $('#publish-modal').modal('closeModal');
