        menu.classList.toggle("show");
    });

    document.addEventListener("click", function() {
        menu.classList.remove("show");
    });

    // Klik item
    $('#bulkDropdown').on('click', '.dropdown-item', function (e) {
        e.stopPropagation();

        const value = $(this).attr('data-value');
        if (value === 'all') {
            selectAllGlobal = true;
            selectedIds.clear();
            
            $('#select-page').prop('checked', true).change();
        }

        if (value === 'none') {
            selectAllGlobal = false;
            selectedIds.clear();
            
            $('#select-page').prop('checked', false).change();
        }

        updateSelectedCount();
        updateBulkLabel();

        $('.dropdown-menu').hide();
    });

    // ketika select-all diklik
    $('#select-all').on('change', function () {
        $('.row-checkbox').prop('checked', this.checked);
        updateSelectedCount();
        updateBulkLabel();
    });

    // reload saat dropdown berubah
    $('#status-filter, #category-filter').on('change', function () {
        table.ajax.reload();
    });

    // Append Element For Selected Items Count
    table.on('init', function () {
        $('.dt-info').append(' <span id="selected-count-container" style="display:none">(<span id="selected-count">0 items selected</span>)</span>');
    });

    table.on('draw', function () {
        if (selectAllGlobal) {
            $('.row-checkbox').prop('checked', true);
            $('#select-page').prop('checked', true);
        } else {
            $('.row-checkbox').each(function () {
                const id = $(this).val();
                $(this).prop('checked', selectedIds.has(id));
            });
            const allChecked = $('.row-checkbox').length > 0 && $('.row-checkbox:checked').length === $('.row-checkbox').length;
            $('#select-page').prop('checked', allChecked);
        }
        updateSelectedCount();
        updateBulkLabel();
    });

    // Handle click on checkbox
    $('#select-page').on('click', function () {
        selectAllGlobal = false;
    });
    $('#select-page').on('change', function () {
        const checked = this.checked;
        if (checked) {
            $('.row-checkbox').each(function () {
                const id = $(this).val();
                selectedIds.add(id);
            });
            $('.row-checkbox').prop('checked', true);
        } else {
            selectedIds.clear();
            $('.row-checkbox').prop('checked', false);
        }
        updateSelectedCount();
        updateBulkLabel();
    });
});
</script>