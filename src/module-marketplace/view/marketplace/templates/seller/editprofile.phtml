        $("#seller_region_id_id").on("change", function () {
            if ($(this).val() && $("#seller_region").length > 0) {
                $("#seller_region").val($("#seller_region_id_id option:selected").text());
            } else if ($("#seller_region").length > 0) {
                $("#seller_region").val(old_region_name);
            }
        })
    })
