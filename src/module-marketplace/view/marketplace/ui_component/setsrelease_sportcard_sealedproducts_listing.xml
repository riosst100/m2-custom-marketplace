<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">setsrelease_sportcard_sealedproducts_listing.setsrelease_sportcard_sealedproducts_listing_data_source</item>
            <item name="deps" xsi:type="string">setsrelease_sportcard_sealedproducts_listing.setsrelease_sportcard_sealedproducts_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">sportcard_sealedproducts_columns</item>
    </argument>
    <dataSource name="setsrelease_sportcard_sealedproducts_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TCGCollective\MarketPlace\Ui\DataProvider\ProductCreation\SetReleaseGridDataProvider</argument>
            <argument name="name" xsi:type="string">setsrelease_sportcard_sealedproducts_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter_url_params" xsi:type="array">
                        <item name="sc_release" xsi:type="string">*</item>
                    </item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                        <item name="cacheRequests" xsi:type="boolean">false</item>
                    </item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <filters name="listing_filters">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="statefull" xsi:type="array">
                        <item name="applied" xsi:type="boolean">false</item>
                    </item>
                    <item name="childDefaults" xsi:type="array">
                        <item name="provider" xsi:type="string">setsrelease_sportcard_sealedproducts_listing.setsrelease_sportcard_sealedproducts_listing.listing_top.listing_filters</item>
                        <item name="imports" xsi:type="array">
                            <item name="visible" xsi:type="string">setsrelease_sportcard_sealedproducts_listing.setsrelease_sportcard_sealedproducts_listing.sportcard_sealedproducts_columns:${ $.index }.visible</item>
                        </item>
                    </item>
                </item>
            </argument>
            <filterSelect name="release_year" provider="${ $.parentName }">
                <settings>
                    <options class="TCGCollective\ProductAttributesLink\Model\Source\PlatformDatabase\SportCard\ReleaseYear"/>
                    <caption translate="true">Filter by Release Year...</caption>
                    <label translate="true">Release Year</label>
                    <dataScope>release_year</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
            <filterSelect name="sc_release" provider="${ $.parentName }">
                <settings>
                    <options class="TCGCollective\ProductAttributesLink\Model\Source\PlatformDatabase\SportCard\ScRelease"/>
                    <caption translate="true">Filter by Release...</caption>
                    <label translate="true">Release</label>
                    <dataScope>sc_release</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
            <filterSelect name="language" provider="${ $.parentName }">
                <settings>
                    <options class="TCGCollective\ProductAttributesLink\Model\Source\PlatformDatabase\SportCard\Language"/>
                    <caption translate="true">Filter by Language...</caption>
                    <label translate="true">Language</label>
                    <dataScope>language</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
        </filters>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="sportcard_sealedproducts_columns">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="resizeConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">true</item>
                </item>
            </item>
        </argument>
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                    <item name="resizeEnabled" xsi:type="boolean">false</item>
                    <item name="resizeDefaultWidth" xsi:type="string">55</item>
                    <item name="sortOrder" xsi:type="number">0</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="images" class="TCGCollective\ProductAttributesLink\Ui\Component\Listing\Columns\Image">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Images</item>
                    <item name="resizeEnabled" xsi:type="boolean">false</item>
                    <item name="resizeDefaultWidth" xsi:type="string">100</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                </item>
            </argument>
        </column>
        <column name="all_images" class="TCGCollective\ProductAttributesLink\Ui\Component\Listing\Columns\AllImages">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Images</item>
                    <item name="resizeEnabled" xsi:type="boolean">false</item>
                    <item name="resizeDefaultWidth" xsi:type="string">100</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                </item>
            </argument>
        </column>
        <column name="sc_sealed_products">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="add_field" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string" translate="true">Sealed Products</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="filter" xsi:type="string">text</item>
                </item>
            </argument>
        </column>
        <column name="release_year">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="add_field" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string" translate="true">Release Year</item>
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
        </column>
        <column name="language">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="add_field" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string" translate="true">Language</item>
                    <item name="sortOrder" xsi:type="number">60</item>
                </item>
            </argument>
        </column>
    </columns>
</listing>
