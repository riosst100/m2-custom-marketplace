<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">games_sets_form.games_sets_form_data_source</item>
            <item name="deps" xsi:type="string">games_sets_form.games_sets_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Lego Sets Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">games_sets_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">TCGCollective\ProductAttributesLink\Block\Adminhtml\LegoSets\Back</item>
            <item name="delete" xsi:type="string">TCGCollective\ProductAttributesLink\Block\Adminhtml\LegoSets\Delete</item>
            <item name="save" xsi:type="string">TCGCollective\ProductAttributesLink\Block\Adminhtml\LegoSets\Save</item>
        </item>
    </argument>
    <dataSource name="games_sets_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TCGCollective\ProductAttributesLink\Ui\DataProvider\Form\GamesSetsDataProvider</argument>
            <argument name="name" xsi:type="string">games_sets_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="*/platformDatabase/save"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="games_sets">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Lego Sets</item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>
        <field name="games_set_name">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">TCGCollective\ProductAttributesLink\Model\Source\GamesMapping\Set</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Set Name</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">games_sets</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
