<script>
    require(['jquery', 'Magento_Ui/js/modal/confirm'], function ($, confirm) {
        $(function () {
            var $form = $('form.editprofile');

            if (!$form.length) {
                return;
            }

            // Snapshot initial values
            function getRegionDisplay() {
                var $select = $('#seller_region_id_id');
                if ($select.is(':visible')) {
                    var val = $select.val() || '';
                    var txt = $select.find('option:selected').text() || '';
                    return 'select|' + val + '|' + txt;
                }
                var textVal = ($('#seller_region').val() || '').trim();
                return 'text|' + textVal;
            }

            function snapshot() {
                return {
                    address1: ($("input[name='address_line_1']").val() || '').trim(),
                    address2: ($("input[name='address_line_2']").val() || '').trim(),
                    country: ($('#seller_country_id').val() || '').toString(),
                    regionDisplay: getRegionDisplay(),
                    city: ($("input[name='city']").val() || '').trim(),
                    postcode: ($("input[name='postcode']").val() || '').trim(),
                    telephone: ($("input[name='telephone']").val() || '').trim()
                };
            }

            var initial = snapshot();
            var confirmationAccepted = false;
            var lastClickedSubmit = null;

            function hasAddressChanged() {
                var current = snapshot();
                return (
                    current.address1 !== initial.address1 ||
                    current.address2 !== initial.address2 ||
                    current.country !== initial.country ||
                    current.regionDisplay !== initial.regionDisplay ||
                    current.city !== initial.city ||
                    current.postcode !== initial.postcode ||
                    current.telephone !== initial.telephone
                );
            }

            function showConfirmAndSubmit() {
                confirm({
                    title: 'Confirm change of address',
                    content: 'You need to reupload document to verify your new address',
                        modalClass: 'address-reverify-confirm-modal',
                        actions: {
                        confirm: function () {
                            confirmationAccepted = true;
                            // Use the original button if available to preserve any button-specific behaviors
                            if (lastClickedSubmit && lastClickedSubmit instanceof HTMLElement) {
                                lastClickedSubmit.click();
                            } else {
                                $form.trigger('submit');
                            }
                        },
                        cancel: function () {
                            confirmationAccepted = false;
                        }
                    },
                    buttons: [{
                        text: 'Cancel',
                        class: 'action-secondary action-dismiss',
                        click: function (event) {
                            this.closeModal(event);
                        }
                    }, {
                        text: 'Confirm',
                        class: 'action-primary action-accept',
                        click: function (event) {
                            confirmationAccepted = true;
                            if (lastClickedSubmit && lastClickedSubmit instanceof HTMLElement) {
                                lastClickedSubmit.click();
                            } else {
                                $form.trigger('submit');
                            }
                            this.closeModal(event);
                        }
                    }]
                });
            }

            // Intercept submit event as a safety net
            $form.on('submit.addressConfirm', function (e) {
                if (confirmationAccepted) {
                    return true;
                }
                if (hasAddressChanged()) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    showConfirmAndSubmit();
                    return false;
                }
                return true;
            });

            // Intercept click on submit buttons at capture phase to prevent early native submit
            var submitButtons = $form.find("button[type='submit'], input[type='submit']");
            submitButtons.each(function () {
                var btn = this;
                btn.addEventListener('click', function (ev) {
                    lastClickedSubmit = btn;
                    if (confirmationAccepted) {
                        return; // allow normal flow
                    }
                    if (hasAddressChanged()) {
                        // Block default and other handlers
                        ev.preventDefault();
                        ev.stopPropagation();
                        if (typeof ev.stopImmediatePropagation === 'function') {
                            ev.stopImmediatePropagation();
                        }
                        showConfirmAndSubmit();
                    }
                }, true); // capture phase
            });
        });
    });
</script>
    <style>
        /* Style for address re-verify confirmation modal content */
        .address-reverify-confirm-modal .modal-content {
            font-size: 17px;
            font-weight: 500;
        }
    </style>
