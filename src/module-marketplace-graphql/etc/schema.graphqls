type Query {
  products (
        search: String @doc(description: "One or more keywords to use in a full-text search."),
        category_uid: String @doc(description: "One or more keywords to use in a full-text search."),
        filter: ProductAttributeFilterInput @doc(description: "The product attributes to search for and return."),
        pageSize: Int = 20 @doc(description: "The maximum number of results to return at once. The default value is 20."),
        currentPage: Int = 1 @doc(description: "The page of results to return. The default value is 1."),
        sort: ProductAttributeSortInput @doc(description: "Specifies which attributes to sort on, and whether to return the results in ascending or descending order.")
    ): Products
    @resolver(class: "Magento\\CatalogGraphQl\\Model\\Resolver\\Products") @doc(description: "Search for products that match the criteria specified in the `search` and `filter` attributes.") @cache(cacheIdentity: "Magento\\CatalogGraphQl\\Model\\Resolver\\Product\\Identity")
  sellerCountries: [Country] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SellerCountries") @doc(description: "Seller countries.")
  sellerCategories(
      sellerUrl: String!
      filters: CategoryFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
      pageSize: Int = 20 @doc(description: "Specifies the maximum number of results to return at once. The default value is 20.")
      currentPage: Int = 1 @doc(description: "Specifies which page of results to return. The default value is 1.")
    ): [SellerCategoryTree] @doc(description: "Return an array of categories based on the specified filters.") @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SellerCategoriesQuery") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SellerCategory\\SellerCategoriesIdentity") @deprecated(reason: "Use `categories` instead.")
  collectibleGameSets(categoryUrlKey: String!, productType: String): [CollectibleGameSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\CollectibleGameSets") @doc(description: "Seller countries.")
  shopByCard(categoryUrlKey: String!, productType: String, filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")): [ShopByCard] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShopByCard") @doc(description: "Seller countries.")
  sportCardsSets(
    categoryUrlKey: String!, 
    setType: String, 
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): [SportCardsSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SportCardsSets") @doc(description: "Seller countries.")
  getSetsData(
    categoryUrlKey: String!, 
    activeTab: String,
    activeFilter: String,
    shopby: String,
    set_filters: [SetFiltersInput],
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): SetsDataOutput @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SetsData") @doc(description: "Seller countries.") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SetsData\\Identity")
  nonSportCardsSets(
    categoryUrlKey: String!, 
    setType: String,
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): [NonSportCardsSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\NonSportCardsSets") @doc(description: "Seller countries.")
 legoSets(
    categoryUrlKey: String!, 
    activeTab: String,
    activeFilter: String,
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): [LegoSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\LegoSets") @doc(description: "Seller countries.")
  trainsSets(
    categoryUrlKey: String!, 
    activeTab: String,
    activeFilter: String,
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): [TrainsSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\TrainsSets") @doc(description: "Seller countries.") 
  shopByVehicles(
    categoryUrlKey: String!, 
    activeTab: String,
    activeFilter: String,
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): [LegoSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShopByVehicles") @doc(description: "Seller countries.")
  miniatureGameSets(
    categoryUrlKey: String!, 
    activeTab: String,
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): [MiniatureGameSets] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\MiniatureGameSets") @doc(description: "Seller countries.")
  shopByData(
    activeFilter: String,
    categoryUrlKey: String!,
    categoryUrlPath: String,
    attributeCode: String,
    shopby: String,
    search: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): ShopByDataOutput @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShopByData") @doc(description: "Seller countries.") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShopByData\\Identity")
  showMoreData(
    activeFilter: String,
    categoryUrlKey: String!,
    categoryUrlPath: String,
    attributeCode: String,
    shopby: String,
    search: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): ShopByDataOutput @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShowMoreData") @doc(description: "Seller countries.") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShopByData\\Identity")
  shopByBrands(
    activeFilter: String,
    categoryUrlKey: String!, 
    attributeCode: String,
    shopby: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): ShopByBrands @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ShopByBrands") @doc(description: "Seller countries.")
  customSubFilters(
    category: String,
    categoryId: String,
    shopby: String,
    filterBy: String,
    search: String,
    filters: ProductAttributeFilterInput @doc(description: "Identifies which Category filter inputs to search for and return.")
  ): CustomSubFiltersOutput @doc(description: "A bucket that contains the attribute code and label for each filterable option.") @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\CustomSubFilters") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\CustomSubFilters\\Identity")
  masterAttributes: [MasterAttributesOutput] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\MasterAttributes") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\MasterAttributes\\Identity")
  subFilters: [SubFiltersOutput] @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SubFilters") @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\SubFilters\\Identity")
  productFaqList(product_id: Int!): [ProductFaq]
        @resolver(
            class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Faq\\ProductFaqList"
        )
  getFaqCategories(product_id: Int!): [FaqCategory] 
        @resolver(
            class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Faq\\GetFaqCategories"
        )
  getAgeVerificationConfig(
    attribute_code: String
    attribute_option: String
    category_uid: String
  ): AgeVerificationConfig 
    @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\AgeVerification\\AgeVerificationConfig") 
    @cache(cacheIdentity: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\AgeVerification\\AgeVerificationConfig\\Identity")
    @doc(description: "Delete the current logged-in customer's account.")
}

type Mutation {
  deleteCustomerAccount: DeleteAccountOutput @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\DeleteAccount") @doc(description: "Delete the current logged-in customer's account.")
  confirmCustomerEmail(
        id: Int!
        key: String!
    ): ConfirmCustomerEmailOutput
        @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ConfirmCustomerEmail")
        @doc(description: "Confirm customer email based on id and key.")
  resendCustomerConfirmation(
        email: String!
    ): ResendCustomerConfirmationOutput
        @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\ResendCustomerConfirmation")
        @doc(description: "Resend the customer account confirmation email.")
  addProductFaq(input: AddProductFaqInput!): AddProductFaqOutput
        @resolver(
            class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Faq\\AddProductFaq"
        )
}

type AgeVerificationConfig {
  status: Boolean
  minimum_age: Int
}

type SellerMessage {
  seller: Seller
    @doc(description: "Seller messages")
    @resolver(class: "TCGCollective\\MarketplaceGraphQl\\Model\\Resolver\\Messages\\Seller")
}

type ConfirmCustomerEmailOutput {
    success: Boolean!
    message: String!
}

input CustomerInput {
  address: CustomerAddressInput!
}

type ResendCustomerConfirmationOutput {
    success: Boolean!
    message: String!
}

type DeleteAccountOutput {
  success: Boolean!
  message: String
}

