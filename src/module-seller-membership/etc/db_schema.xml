<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="marketplace_membership_addon" resource="default" engine="innodb" comment="">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="seller_id" unsigned="true" nullable="true" identity="false" comment="Seller ID"/>
        <column xsi:type="int" name="website_id" unsigned="true" nullable="true" identity="false" comment="Website ID"/>
        <column xsi:type="int" name="status" unsigned="true" nullable="true" identity="false" comment="Status"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" identity="false" comment="Product ID"/>
        <column xsi:type="text" name="product_options" nullable="true" comment="Target Attribute Options"/>
        <column xsi:type="int" name="item_id" unsigned="true" nullable="true" identity="false" comment="Item ID"/>
        <column xsi:type="varchar" name="name" nullable="false" comment="Name"/>
        <column xsi:type="varchar" name="duration" nullable="false" comment="Duration"/>
        <column xsi:type="decimal" name="price" precision="12" scale="4" default="0.0000" nullable="false" comment="Price"/>
        <column xsi:type="timestamp" name="expiration_date" nullable="false" comment="Expiration Time"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="marketplace_membership_addon_transaction" resource="default" engine="innodb" comment="">
        <column xsi:type="int" name="transaction_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="seller_id" unsigned="true" nullable="true" identity="false" comment="Seller ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" identity="false" comment="Seller ID"/>
        <column xsi:type="varchar" name="package" nullable="false" comment="Name"/>
        <column xsi:type="varchar" name="duration_unit" nullable="false" comment="Duration"/>
        <column xsi:type="int" name="duration" unsigned="true" nullable="true" identity="false" comment="Website ID"/>
        <column xsi:type="decimal" name="amount" precision="12" scale="4" default="0.0000" nullable="false" comment="Price"/>
        <column xsi:type="text" name="additional_info" nullable="true" comment="Target Attribute Options"/>
        <column xsi:type="text" name="product_options" nullable="true" comment="Target Attribute Options"/>
        <column xsi:type="varchar" name="order_increment_id" nullable="false" comment="Duration"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" identity="false" comment="Status"/>
        <column xsi:type="int" name="website_id" unsigned="true" nullable="true" identity="false" comment="Product ID"/>
        <column xsi:type="int" name="item_id" unsigned="true" nullable="true" identity="false" comment="Item ID"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="transaction_id"/>
        </constraint>
    </table>
</schema>
