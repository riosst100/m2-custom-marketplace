    require(["jquery", "prototype", "mage/adminhtml/form"], function ($) {
        new regionUpdater("seller_country_id", "seller_region_id", "seller_region_id_id", <?= $_directoryHelper->getRegionJson();?>);

        var old_region_name = $("#seller_region").val();
        
